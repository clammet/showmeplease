{
  "name": "showmeplease",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/sync-convex-env.mjs && concurrently -k -n convex,server,web -c magenta,yellow,cyan \"CONVEX_AGENT_MODE=anonymous npx convex dev\" \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vinext dev -H 127.0.0.1",
    "dev:server": "PORT=${BACKEND_PORT:-8817} tsx watch server/index.ts",
    "devsetup": "node scripts/devsetup.mjs",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vinext build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/backend/index.mjs",
    "start": "node dist/backend/index.mjs",
    "image:build": "docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD) --tag ${IMAGE_NAME:-showmeplease}:${IMAGE_TAG:-latest} .",
    "image:publish": "docker buildx build --build-arg GIT_COMMIT=$(git rev-parse HEAD) --platform ${IMAGE_PLATFORMS:-linux/amd64,linux/arm64} --tag ${IMAGE_NAME:?Set IMAGE_NAME to the registry/repository}:${IMAGE_TAG:-latest} --push .",
    "test": "pnpm test:unit && pnpm build && node --test tests/backend.test.mjs tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/hub.test.mjs tests/browserAudio.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern convex/_generated"
  },
  "dependencies": {
    "@clammet/convex-googly-auth": "1.0.1",
    "convex": "1.45.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jose": "6.2.12",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "ws": "8.21.3"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
