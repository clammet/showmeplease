# Copy to .env.local (dev) or provide as container environment (prod).
# `pnpm devsetup` creates a working .env.local for local development.

# --- Cloudflare Realtime SFU (media relay; the heavy lifting) ---
REALTIME_APP_ID=""
REALTIME_APP_SECRET=""

# --- Convex (auth backend) ---
# Local dev: http://127.0.0.1:3210 / 3211 (written by `pnpm devsetup`).
# Production: your Convex deployment's .convex.cloud / .convex.site URLs,
# or a self-hosted Convex instance.
VITE_CONVEX_URL=""
VITE_CONVEX_SITE_URL=""

# --- Google sign-in (via @clammet/convex-googly-auth) ---
# The backend only needs AUTH_GOOGLE_ID (to verify admin ID tokens).
# AUTH_GOOGLE_SECRET is used by the Convex deployment and by
# scripts/sync-convex-env.mjs, which copies these into local Convex
# (AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, SITE_URL, ADMIN_EMAILS).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Optional: TURN for viewers behind strict NATs ---
# A Cloudflare Realtime TURN key. Without it only STUN is used.
# TURN_KEY_ID=""
# TURN_KEY_API_TOKEN=""

# --- Admin dashboard (/admin) ---
# Comma-separated Google account emails allowed to use the admin API.
ADMIN_EMAILS=""
# Local-only escape hatch: open /admin without sign-in. NEVER in production.
# ADMIN_ALLOW_INSECURE=1

# --- Optional: Cloudflare-metered SFU egress in the admin dashboard ---
# API token needs Account Analytics:Read. Falls back gracefully when unset.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# --- Server ---
# PORT=8080
# HOST=0.0.0.0
# STATIC_ROOT=dist/client
# Public URL used for absolute links in HTML (og:image etc). If unset the Host
# header is used after a strict character check.
# PUBLIC_ORIGIN=https://share.example.com
# Set to 1 only behind a reverse proxy you control; enables X-Forwarded-* for
# client addresses (rate limiting) and the public origin.
# TRUST_PROXY=1
