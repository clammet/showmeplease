{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Pins Docker images and GitHub Actions by digest, pins devDependencies,
    // enables the dependency dashboard issue and config-migration PRs.
    "config:best-practices",
    // This is an app, not a library: keep production dependencies pinned
    // exactly too.
    ":pinAllExceptPeerDependencies",
    // Updates env vars annotated with `# renovate: datasource=... depName=...`
    // in workflows — used for RENOVATE_VERSION in renovate.yml.
    "customManagers:githubActionsVersions",
  ],

  // File PRs for known-vulnerable versions from the OSV database, not just
  // when a regular update happens to exist.
  osvVulnerabilityAlerts: true,

  // Fleet-standard soak for every datasource: a fresh npm release or a
  // force-moved upstream tag should not automerge within one cycle; registry
  // malware is usually yanked within days. Vulnerability fix PRs skip it.
  minimumReleaseAge: "3 days",

  // Use GitHub's native auto-merge: the "protect main" ruleset requires both
  // CI checks, so eligible PRs merge minutes after CI goes green instead of
  // waiting for the next Renovate run. Repo admins bypass the ruleset, so
  // direct pushes to main still work.
  platformAutomerge: true,

  // Refresh the lockfile weekly so transitive deps don't rot between direct
  // updates; automerges under the same green-CI rule.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },

  packageRules: [
    {
      description: "Own packages are trusted; take them immediately",
      matchPackageNames: ["@clammet/**"],
      minimumReleaseAge: null,
    },
    {
      description: "Automerge minor/patch and pin/digest updates once CI (lint+build+test and the image build) is green",
      matchUpdateTypes: ["minor", "patch", "pin", "pinDigest", "digest"],
      automerge: true,
    },
    {
      description: "Majors wait for a human",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      description: "0.x minors and pre-release bumps are breaking by semver convention (vitejs/plugin-rsc, vinext) — hold them for a human",
      matchCurrentVersion: "<1.0.0",
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      description: "Our own published image is exempt: digest refreshes in deploy/ should land as soon as CI publishes",
      matchPackageNames: ["ghcr.io/clammet/showmeplease"],
      minimumReleaseAge: null,
    },
    {
      description: "Pins and digest refreshes point at code that already shipped - no soak needed",
      matchUpdateTypes: ["pin", "pinDigest", "digest"],
      minimumReleaseAge: null,
    },
    {
      description: "Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag",
      matchDepNames: ["ghcr.io/renovatebot/renovate"],
      schedule: ["before 6am on monday"],
      pinDigests: false,
    },
  ],
}
