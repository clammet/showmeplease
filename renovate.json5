{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "customManagers:githubActionsVersions"
  ],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "rebaseWhen": "behind-base-branch"
  },
  "packageRules": [
    {
      "description": "Automerge minor/patch and pin/digest updates once CI (lint+build+test and the image build) is green; rebase onto main first so CI ran against the current base",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Attempt major updates automatically after a week; CI must pass before merge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": false
    },
    {
      "description": "Pre-1.0 updates use the same required CI gate",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Our own published image is exempt: digest refreshes in deploy/ should land as soon as CI publishes",
      "matchPackageNames": [
        "ghcr.io/clammet/showmeplease"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Never automerge GitHub Actions digest changes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": false
    },
    {
      "description": "Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag",
      "matchDepNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "schedule": [
        "before 6am on monday"
      ],
      "pinDigests": false
    },
    {
      "description": "Keep Node image, CI runtime, and Node types in one tested PR",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "groupName": "Node runtime"
    }
  ],
  "timezone": "Australia/Melbourne",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 0,
  "description": "Renovate owns dependency updates. Tested updates merge after the release soak; unresolved maintenance is reported by the maintenance workflows. See .github/MAINTENANCE.md.",
  "automergeType": "pr",
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>npm) depName=(?<depName>corepack)\\nARG COREPACK_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ]
}
